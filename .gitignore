/android/app/release

# Firebase / Cloud Functions
functions/node_modules/
firebase-debug.log
firebase-debug.*.log
.firebase/
firestore-debug.log
ui-debug.log

# Secrets — never commit real credentials (SECURITY.md section 4).
# NOTE: google-services.json / GoogleService-Info.plist are deliberately NOT
# listed here — they are public project identifiers, not secrets.
.env
.env.*
functions/.env
functions/.env.*
*-service-account.json
serviceAccountKey.json
# Firebase's own download naming is `<project>-firebase-adminsdk-<hash>.json`,
# which `*-service-account.json` above does NOT match — a real gap, found when
# the first key was actually downloaded. An Admin SDK key bypasses every rule
# in firestore.rules, so this must not depend on remembering to rename a file.
*firebase-adminsdk*.json
# The whole folder, so anything dropped in it is covered whatever it is called.
secrets/

android/build/
lib/tmp_dbg.dart
lib/tmp_width_check.dart
