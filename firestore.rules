rules_version = '2';

// Firestore Security Rules — Kurdistan Paradise Travel Guide (mobile app).
//
// Per SECURITY.md section 1: DENY BY DEFAULT. Nothing is readable or
// writable unless a rule below explicitly allows it. Collections are added
// here as the screen that uses them is built — not as end-of-project cleanup.
//
// Collections covered so far:
//   password_reset_codes  — Verification Code screen (server-only)
//   mail                  — Verification Code screen (server-only)
//   featured              — Home screen carousel (public read)
//   nature_spots          — Home screen count() (public read)
//   tours                 — Explore Tours screen (public read)
//   tours/*/reviews       — tour ratings (public read of published; one
//                           owner-written doc per user)
//   currency_rates        — indicative FX rates (public read, admin write)
//   favorites             — Where to Stay / Explore Nature heart, listed by
//                           the Favorites screen (owner-only)
//   bookings              — My Bookings screen (owner-only READ; no client write)
//   nature_spots/*/reviews       — Reviews & Ratings screen (public read of
//                                  published; one owner-written doc per user)
//   nature_spots/*/reviews/*/votes — helpful votes (owner-only, one per user)
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin status comes from a custom claim on the Auth token, never from a
    // client-writable field (SECURITY.md section 3).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // -------------------------------------------------------------------
    // users/{uid} — the signed-in user's own profile, created by the
    // Register screen.
    //
    // The security question here is not "can they write?" but "WHICH fields
    // can they write?". A user creating their own document must never be
    // able to set `role: "admin"`, nor to claim `emailVerified: true` /
    // `phoneVerified: true` — those mirror Firebase Auth, which is the real
    // source of truth, and are written only by Cloud Functions (Admin SDK,
    // which bypasses these rules).
    //
    // So both create and update are restricted to an explicit allow-list of
    // fields. Anything outside it is rejected regardless of its value.
    // -------------------------------------------------------------------
    match /users/{userId} {
      // Fields the client may ever set on itself.
      function writableFields() {
        return [
          'name', 'email', 'phone', 'dateOfBirth', 'gender',
          'profileImageUrl', 'preferredLanguage', 'preferredCurrency',
          'termsAcceptedAt', 'termsVersion',
          'createdAt', 'updatedAt', 'source'
        ];
      }

      function onlyWritableFields() {
        return request.resource.data.keys().hasOnly(writableFields());
      }

      // Updates compare only changed keys so server-owned fields such as
      // `hasPaymentMethod` can remain on the document without becoming
      // client-writable.
      function onlyWritableFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(writableFields());
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Optional on every write (create or a partial merge-update like the
      // Home screen drawer's Currency row), but if present must be one of
      // the two supported codes.
      function validCurrency() {
        return !('preferredCurrency' in request.resource.data.keys())
          || request.resource.data.preferredCurrency in ['USD', 'IQD', 'EUR'];
      }

      function validLanguage() {
        return !('preferredLanguage' in request.resource.data.keys())
          || request.resource.data.preferredLanguage in ['en', 'ku', 'ar'];
      }

      function validShape() {
        return request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 100
          && request.resource.data.email is string
          && request.resource.data.phone is string
          && request.resource.data.dateOfBirth is timestamp
          // Gender is optional, but if present must be one of three values.
          && (!('gender' in request.resource.data.keys())
              || request.resource.data.gender in ['male', 'female', 'other'])
          && validCurrency()
          && validLanguage();
      }

      allow get: if isOwner();
      // No `list`: nobody may enumerate the user base.
      allow create: if isOwner() && onlyWritableFields() && validShape();
      // Updates may not change the document's owner-critical identity, and
      // still may not introduce privileged fields. A merge-update (e.g. just
      // `profileImageUrl` or `preferredCurrency`) does not carry every field
      // `validShape()` checks, so only the fields actually present are
      // re-validated here.
      allow update: if isOwner()
        && onlyWritableFieldsChanged()
        && request.resource.data.email == resource.data.email
        && validCurrency()
        && validLanguage();
      // Account deletion goes through a Cloud Function so Auth, Storage and
      // Firestore are cleaned up together (SECURITY.md 9).
      allow delete: if false;
    }

    // The `usernames` collection was removed with the username feature. It is
    // deliberately NOT re-added as an open path: any collection without a rule
    // is denied by default (SECURITY.md 1), which is exactly what we want for
    // a namespace that no longer exists.

    // -------------------------------------------------------------------
    // legal_documents — versioned Terms of Service / Privacy Policy text.
    //
    // PUBLIC read, including unauthenticated: a user has to be able to read
    // the Terms before they have an account, and consent is collected during
    // registration. There is nothing sensitive here — it is the text every
    // user is meant to see.
    //
    // Admin-only write via the custom claim (SECURITY.md 3), never from the
    // mobile client. If the client could write this, it could rewrite the
    // agreement it is about to accept.
    // -------------------------------------------------------------------
    match /legal_documents/{docId} {
      allow get: if true;
      // No `list`: documents are fetched by known id, not enumerated.
      allow list: if false;
      allow create, update, delete: if request.auth != null
        && request.auth.token.admin == true;
    }

    // -------------------------------------------------------------------
    // help_topics — the ten Help & Support categories (DATA_MODEL.md).
    //
    // PUBLIC read, including unauthenticated, and deliberately so: a user who
    // cannot sign in is exactly the person who needs the help centre. There is
    // nothing user-specific in it.
    //
    // No `list`, matching legal_documents: every id is fixed in
    // `HelpTopic.docId`, so the screen fetches by known id and never needs to
    // enumerate the collection. Denying it keeps one more query surface shut.
    //
    // Admin-only write via the custom claim (SECURITY.md 3). Support answers
    // are the app's own voice — a client that could write here could publish
    // "call this number to verify your card" to every user of the app, which
    // is a phishing surface, not merely an editorial one.
    // -------------------------------------------------------------------
    match /help_topics/{topicId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // password_reset_codes — hashed one-time password-reset codes.
    //
    // NO client access whatsoever, in either direction. Only the Cloud
    // Functions (Firebase Admin SDK) touch this collection, and the Admin
    // SDK bypasses these rules entirely.
    //
    // Read access would leak the code hash + salt to anyone who could guess
    // a document id, so this stays fully closed rather than "authenticated
    // users only" — the client never has a legitimate reason to read it.
    // -------------------------------------------------------------------
    match /password_reset_codes/{docId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------
    // email_verify_codes / email_change_codes — hashed one-time codes for
    // proving ownership of an email address, at registration and when
    // changing it.
    //
    // Closed for exactly the same reason as password_reset_codes above: the
    // documents hold a code hash and its salt, and the client never has a
    // legitimate reason to read or write them. The Cloud Functions use the
    // Admin SDK, which bypasses these rules.
    //
    // Note the document id is the uid, so "deny read" is what stops a signed-in
    // user from simply fetching their own pending code instead of receiving it
    // by email — which would defeat the whole verification.
    // -------------------------------------------------------------------
    match /email_verify_codes/{docId} {
      allow read, write: if false;
    }

    match /email_change_codes/{docId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------
    // mail — outbound email queue consumed by the "Trigger Email from
    // Firestore" extension. Written only by Cloud Functions.
    //
    // Client write access here would let anyone send arbitrary email from
    // the project's verified sender address.
    // -------------------------------------------------------------------
    match /mail/{docId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------
    // featured — the home screen's carousel, curated in the admin panel.
    //
    // PUBLIC read, including unauthenticated: the home screen is fully
    // browsable by a guest who has not signed in, so the carousel cannot
    // require auth. `list` IS granted here (unlike legal_documents), because
    // the screen queries the collection rather than fetching a known id.
    //
    // Admin-only write — this is catalog/marketing content, and a client
    // that could write it could put anything on the app's front page.
    //
    // `type` and `referenceId` are validated HERE as well as in the seeder
    // (approved 2026-09-15, after the launch-readiness audit found three of
    // the four slides pointing at documents that do not exist). The rules
    // cannot check that the target document is real — that needs a read the
    // seeder does — but they can stop a slide whose `type` names no
    // collection at all, which is a card the app can never open.
    // -------------------------------------------------------------------
    match /featured/{itemId} {
      function validType() {
        return 'type' in request.resource.data.keys()
          && request.resource.data.type in
               ['nature_spot', 'hotel', 'car', 'tour', 'flight'];
      }

      function validReference() {
        return 'referenceId' in request.resource.data.keys()
          && request.resource.data.referenceId is string
          && request.resource.data.referenceId.size() > 0;
      }

      allow get, list: if true;
      allow create, update: if isAdmin() && validType() && validReference();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // nature_spots — catalog data. Public read, admin-only write, per
    // SECURITY.md section 1.
    //
    // Read by two screens: the home screen's count() aggregation, and the
    // Explore Nature list screen, which queries the documents themselves
    // (highlighted carousel + filtered list). `list` is required for both —
    // count() is not permitted without it either.
    //
    // Public read is correct and deliberate: this is the catalog the whole
    // app exists to show, browsable by a guest who has never signed in.
    // There is nothing user-specific in it. Write stays admin-only — a
    // client that could write here could change prices, ratings and place
    // descriptions for every user.
    // -------------------------------------------------------------------
    match /nature_spots/{spotId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();

      // Public visitor feedback, written by the Reviews & Ratings screen.
      //
      // **The document id IS the author's uid.** That is what makes "one
      // review per person per place" a rule rather than a hope: without it a
      // client could post the same review a hundred times and drag the
      // average wherever it liked, and no rule could tell the difference
      // between that and a hundred honest visitors.
      //
      // `rating` is a **number in 0.5 steps from 0.5 to 5**, not an integer —
      // the design draws half stars (6.0/10 = 3.5 stars). The 0.5-step check
      // is `rating * 2 == round(rating * 2)`, so 3.7 is rejected even though
      // it is inside the range; an arbitrary decimal would be a value no UI
      // in this app can produce.
      //
      // `helpfulCount` is **server-owned** and deliberately absent from both
      // allow-lists. It is maintained by the `syncReviewHelpfulCount`
      // Firestore trigger from the `votes` subcollection below. A client that
      // could write it could simply declare its own review the most helpful
      // one on the page.
      match /reviews/{reviewId} {
        // Fields the author may ever set on their own review.
        function authorFields() {
          return [
            'userId', 'userName', 'avatarUrl', 'rating', 'comment',
            'status', 'createdAt', 'updatedAt'
          ];
        }

        function validRating(rating) {
          return rating is number
            && rating >= 0.5
            && rating <= 5
            && rating * 2 == math.round(rating * 2);
        }

        function validReviewBody() {
          return request.auth != null
            // The id is the uid, so a user gets exactly one review here.
            && reviewId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.userName is string
            && request.resource.data.userName.size() > 0
            && request.resource.data.userName.size() <= 80
            && validRating(request.resource.data.rating)
            && request.resource.data.comment is string
            && request.resource.data.comment.size() >= 3
            && request.resource.data.comment.size() <= 1000
            && request.resource.data.status == 'published'
            && request.resource.data.updatedAt == request.time;
        }

        allow get, list: if resource.data.status == 'published';

        allow create: if validReviewBody()
          && request.resource.data.keys().hasOnly(authorFields())
          && request.resource.data.createdAt == request.time;

        // Compares only the CHANGED keys, so the server-owned `helpfulCount`
        // can sit on the document without the author having to send it back
        // — and without it becoming writable.
        allow update: if request.auth != null
          && resource.data.userId == request.auth.uid
          && validReviewBody()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(authorFields())
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isAdmin() || (request.auth != null
          && resource.data.userId == request.auth.uid);

        // -----------------------------------------------------------------
        // votes/{voterId} — "I found this review helpful", one per person.
        //
        // The vote is a DOCUMENT rather than a counter the client increments,
        // for the same reason the review id is the uid: a document keyed by
        // the voter's uid physically cannot be cast twice, whereas an
        // increment can be sent in a loop. The visible number comes from
        // `helpfulCount` on the parent review, which only the trigger writes.
        //
        // `list` is denied: nobody needs to enumerate who liked a review, and
        // allowing it would turn "helpful" into a public record of who read
        // what. The screen reads only the viewer's own vote, by known id.
        // -----------------------------------------------------------------
        match /votes/{voterId} {
          function isVoter() {
            return request.auth != null && voterId == request.auth.uid;
          }

          allow get: if isVoter();
          allow list: if false;
          allow create: if isVoter()
            && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdAt == request.time;
          // A vote is cast or withdrawn; there is nothing to edit. Allowing
          // update would only add a way to repoint an existing vote.
          allow update: if false;
          allow delete: if isVoter();
        }
      }
    }

    // -------------------------------------------------------------------
    // tours — catalog data. Public read, admin-only write, exactly like
    // nature_spots above and for the same reasons (SECURITY.md section 1).
    //
    // Read by the Explore Tours screen, which runs two queries against the
    // collection (the highlighted carousel, and the catalog the search box
    // and date picker filter in Dart), so `list` is required.
    //
    // Public read is correct and deliberate: this is the catalog the whole
    // app exists to show, browsable by a guest who has never signed in.
    // There is nothing user-specific in it.
    //
    // Write stays admin-only, and here that is a **payment-adjacent**
    // control, not only an editorial one: `pricePerPerson` and `currency`
    // are what a future checkout would charge against. A client that could
    // write this collection could set its own price to zero before booking.
    // -------------------------------------------------------------------
    match /tours/{tourId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();

      // Public traveller reviews, the same arrangement as
      // nature_spots/*/reviews above — copied deliberately rather than
      // reinvented, so the two catalogs cannot end up with different
      // guarantees about who may rate what.
      //
      // **The document id IS the author's uid.** That is what makes "one
      // review per person per tour" a rule rather than a hope: without it a
      // client could post the same review a hundred times and drag the
      // average wherever it liked.
      //
      // `rating` is a number in 0.5 steps from 0.5 to 5 — the app draws half
      // stars, and an integer cannot hold a 3.5. The step check is
      // `rating * 2 == round(rating * 2)`, so 3.7 is rejected even though it
      // is inside the range.
      //
      // `reviewScore`, `ratingCount` and `ratingBreakdown` on the parent are
      // **server-owned**, written only by the `syncTourReviewAggregates`
      // trigger — which is why they appear in no allow-list here and why the
      // parent stays admin-only write.
      match /reviews/{reviewId} {
        function authorFields() {
          return [
            'userId', 'userName', 'avatarUrl', 'rating', 'comment',
            'status', 'createdAt', 'updatedAt'
          ];
        }

        function isAuthor() {
          return request.auth != null && request.auth.uid == reviewId;
        }

        function validRating() {
          return request.resource.data.rating is number
            && request.resource.data.rating >= 0.5
            && request.resource.data.rating <= 5
            && request.resource.data.rating * 2 ==
                 math.round(request.resource.data.rating * 2);
        }

        function validComment() {
          return request.resource.data.comment is string
            && request.resource.data.comment.size() >= 3
            && request.resource.data.comment.size() <= 1000;
        }

        function validShape() {
          return request.resource.data.keys().hasOnly(authorFields())
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.userName is string
            && request.resource.data.userName.size() > 0
            && request.resource.data.userName.size() <= 80
            && request.resource.data.status == 'published'
            && validRating()
            && validComment()
            && request.resource.data.updatedAt == request.time;
        }

        // Published reviews are public: someone deciding whether to book has
        // to be able to read them before creating an account.
        allow get, list: if resource.data.status == 'published';

        allow create: if isAuthor() && validShape()
          && request.resource.data.createdAt == request.time;
        // `createdAt` is pinned, so an author cannot re-date an old review to
        // push it back to the top of "Most recent".
        allow update: if isAuthor()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(authorFields())
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userName is string
          && request.resource.data.userName.size() > 0
          && request.resource.data.userName.size() <= 80
          && request.resource.data.status == 'published'
          && validRating()
          && validComment()
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin() || isAuthor();

        // Helpful votes are isolated under the tour review, not shared with
        // nature reviews. One document keyed by the voter uid makes a second
        // vote impossible; only the server trigger writes helpfulCount.
        match /votes/{voterId} {
          function isVoter() {
            return request.auth != null && voterId == request.auth.uid;
          }

          allow get: if isVoter();
          allow list: if false;
          allow create: if isVoter()
            && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if isVoter();
        }
      }
    }

    // -------------------------------------------------------------------
    // hotels — catalog data, same posture as nature_spots and tours.
    //
    // PUBLIC read including unauthenticated: Where to Stay is browsable by a
    // guest, and `list` is required because the screen queries the collection
    // rather than fetching known ids.
    //
    // Write stays admin-only, and here that is a **payment-adjacent** control:
    // `pricePerNightFrom` on the hotel and the whole `offers` subcollection are
    // what a checkout would quote against. A client that could write them could
    // set its own price before booking. The charge must still be re-priced
    // server-side at booking time (DATA_MODEL.md) — these rules stop a client
    // editing the catalogue, they are not a substitute for that.
    //
    // The rating aggregates (`reviewScore`, `ratingCount`, `ratingBreakdown`,
    // `categoryScores`) are server-owned and covered by this same admin-only
    // write, exactly as on nature_spots and tours.
    //
    // `currencyCode` is REQUIRED here and validated in the rules, not only in
    // the client (approved 2026-09-15, matching `cars`). `pricePerNightFrom`
    // states no currency of its own, so a document without a code is a price
    // denominated in nothing — and a reader that filled the gap with USD would
    // misprice an IQD property by roughly 1300x. USD and IQD are the two the
    // app supports (DATA_MODEL.md).
    // -------------------------------------------------------------------
    match /hotels/{hotelId} {
      function validCurrency() {
        return 'currencyCode' in request.resource.data.keys()
          && request.resource.data.currencyCode in ['USD', 'IQD'];
      }

      // Prices are stored, never inferred, and must be real non-negative
      // numbers — a string "120" would render as a price and compare as text.
      function validPrice() {
        return !('pricePerNightFrom' in request.resource.data.keys())
          || (request.resource.data.pricePerNightFrom is number
              && request.resource.data.pricePerNightFrom >= 0);
      }

      allow get, list: if true;
      // Admin-only, AND still shape-checked: an admin panel bug must not be
      // able to publish a hotel priced in a currency the app cannot display,
      // or in no currency at all.
      allow create, update: if isAdmin() && validCurrency() && validPrice();
      allow delete: if isAdmin();

      // ----------------------------------------------------------------
      // rooms — permanent room data. Public read, admin-only write.
      // `list` is required: the Room Selection screen enumerates them.
      // ----------------------------------------------------------------
      match /rooms/{roomId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
      }

      // ----------------------------------------------------------------
      // offers — a priced, bookable rate. Public read, admin-only write.
      //
      // `availableQuantity` lives here and is the only source for "Only N
      // rooms left" (DATA_MODEL.md). A client that could write it could
      // manufacture scarcity; one that could write `nightlyPrice` could
      // quote itself any figure. Both stay admin-only.
      //
      // `currency` is REQUIRED and restricted to USD | IQD, for the same
      // reason as the hotel's `currencyCode` — and it matters more here,
      // because this is the figure a checkout quotes against and the one a
      // booking is written in.
      // ----------------------------------------------------------------
      match /offers/{offerId} {
        function validOfferCurrency() {
          return 'currency' in request.resource.data.keys()
            && request.resource.data.currency in ['USD', 'IQD'];
        }

        function validOfferPrices() {
          return (!('nightlyPrice' in request.resource.data.keys())
                  || (request.resource.data.nightlyPrice is number
                      && request.resource.data.nightlyPrice >= 0))
            && (!('totalPrice' in request.resource.data.keys())
                || (request.resource.data.totalPrice is number
                    && request.resource.data.totalPrice >= 0));
        }

        allow get, list: if true;
        allow create, update: if isAdmin()
          && validOfferCurrency()
          && validOfferPrices();
        allow delete: if isAdmin();
      }

      // ----------------------------------------------------------------
      // reviews — identical rules to nature_spots/{id}/reviews, because the
      // Hotel Details page reuses that screen through a service adapter
      // (DATA_MODEL.md). The document id IS the author's uid, which is what
      // makes "one review per person per hotel" enforceable rather than
      // merely intended.
      // ----------------------------------------------------------------
      match /reviews/{reviewId} {
        function authorFields() {
          return [
            'userId', 'userName', 'avatarUrl', 'rating', 'comment',
            'status', 'createdAt', 'updatedAt'
          ];
        }

        function isAuthor() {
          return request.auth != null && request.auth.uid == reviewId;
        }

        function validRating() {
          return request.resource.data.rating is number
            && request.resource.data.rating >= 0.5
            && request.resource.data.rating <= 5
            && request.resource.data.rating * 2 ==
                 math.round(request.resource.data.rating * 2);
        }

        function validComment() {
          return request.resource.data.comment is string
            && request.resource.data.comment.size() >= 3
            && request.resource.data.comment.size() <= 1000;
        }

        function validShape() {
          return request.resource.data.keys().hasOnly(authorFields())
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.userName is string
            && request.resource.data.userName.size() > 0
            && request.resource.data.userName.size() <= 80
            && request.resource.data.status == 'published'
            && validRating()
            && validComment()
            && request.resource.data.updatedAt == request.time;
        }

        allow get, list: if resource.data.status == 'published';

        allow create: if isAuthor() && validShape()
          && request.resource.data.createdAt == request.time;

        // Compares only CHANGED keys, so the server-owned `helpfulCount` can
        // sit on the document without the author having to send it back — and
        // without becoming writable. `createdAt` is pinned so an author cannot
        // re-date an old review to the top of "Most recent".
        allow update: if isAuthor()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(authorFields())
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userName is string
          && request.resource.data.userName.size() > 0
          && request.resource.data.userName.size() <= 80
          && request.resource.data.status == 'published'
          && validRating()
          && validComment()
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin() || isAuthor();

        // --------------------------------------------------------------
        // votes/{voterId} — "I found this review helpful", one per person.
        // A document keyed by the voter cannot be cast twice, whereas an
        // incrementable counter can be sent in a loop. `list` is denied:
        // nobody needs to enumerate who liked a review.
        // --------------------------------------------------------------
        match /votes/{voterId} {
          function isVoter() {
            return request.auth != null && voterId == request.auth.uid;
          }

          allow get: if isVoter();
          allow list: if false;
          allow create: if isVoter()
            && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if isVoter();
        }
      }
    }

    // -------------------------------------------------------------------
    // cars — rental catalogue. Public read, admin-only write (SECURITY.md 1).
    //
    // `list` is required: the Car Rental and Results screens query the
    // collection rather than fetching known ids.
    //
    // The write side is **payment- and inventory-adjacent**, not editorial:
    // `pricePerDay`, `currencyCode`, `extras[].pricePerDay` and every key of
    // `conditions` (deposit, damage excess, cancellation deadline, minimum
    // driver age, required documents) are contractual and financial terms a
    // user acts on. A client that could write them could quote itself a rate
    // no supplier honours, or erase a deposit it is about to be charged.
    //
    // `currencyCode` is validated HERE and not only in the client, because an
    // unsupported code renders a price nobody can act on. USD and IQD are the
    // two the app supports (DATA_MODEL.md).
    // -------------------------------------------------------------------
    match /cars/{carId} {
      function validCurrency() {
        return !('currencyCode' in request.resource.data.keys())
          || request.resource.data.currencyCode in ['USD', 'IQD'];
      }

      // Prices are stored, never inferred, and must be real non-negative
      // numbers — a string "65" would render as a price and compare as text.
      function validPrice() {
        return !('pricePerDay' in request.resource.data.keys())
          || (request.resource.data.pricePerDay is number
              && request.resource.data.pricePerDay >= 0);
      }

      function validFlags() {
        return (!('featured' in request.resource.data.keys())
                || request.resource.data.featured is bool)
          && (!('active' in request.resource.data.keys())
              || request.resource.data.active is bool);
      }

      allow get, list: if true;
      // Admin-only, AND still shape-checked: an admin panel bug must not be
      // able to publish a car priced in a currency the app cannot display.
      allow create, update: if isAdmin()
        && validCurrency()
        && validPrice()
        && validFlags();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // rental_locations — the pickup/drop-off branches the Car Rental search
    // offers (DATA_MODEL.md). Public read including unauthenticated, because
    // the search screen is browsable by a guest; `list` is required since the
    // picker matches a typed query across every branch.
    //
    // Admin-only write: a client that could add a branch could offer a pickup
    // point that does not exist.
    // -------------------------------------------------------------------
    match /rental_locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // currency_rates/latest — one document, read by every screen that shows
    // a converted price.
    //
    // PUBLIC read: a guest browsing the catalog sees prices too.
    //
    // Write is admin/server only, and that is a **financial** control rather
    // than an editorial one: a client that could write this document could
    // make a $500 tour read as $5. The rates are explicitly *indicative* —
    // a charge must be settled in the operator's own currency by the payment
    // processor, never at a rate this app stored (SECURITY.md section 5).
    // -------------------------------------------------------------------
    match /currency_rates/{docId} {
      allow get: if true;
      // `list` is denied: the app reads one known id (`latest`), so there is
      // no reason to allow the collection to be enumerated.
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // favorites — a user's saved places. Strictly owner-only in both
    // directions (SECURITY.md section 1: "users can only read/write their
    // own data").
    //
    // `list` is allowed only because the rule pins resource.data.userId to
    // the caller: Firestore rejects any query that isn't provably limited to
    // that user's own documents, so nobody can enumerate someone else's
    // favourites.
    //
    // Document ids are `{uid}_{itemType}_{itemId}`, but the id is NOT what
    // is trusted — the rules check the userId field, so a forged id gains
    // nothing.
    // -------------------------------------------------------------------
    match /favorites/{favoriteId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function ownsIncoming() {
        return isSignedIn()
          && request.resource.data.userId == request.auth.uid;
      }

      function ownsExisting() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      // A locale map — {en, ku, ar} — with at least an English entry, so a
      // row can always be drawn in some language. Bounded so a client
      // cannot park arbitrary payload on its own favourites: the snapshot
      // is a name and a place line, not free storage.
      function validLocaleMap(field) {
        return field is map
          && field.keys().hasOnly(['en', 'ku', 'ar'])
          && 'en' in field
          && field.en is string
          && field.en.size() > 0
          && field.en.size() <= 200;
      }

      function validShape() {
        return request.resource.data.keys().hasOnly([
            'userId', 'itemType', 'itemId',
            'title', 'locationLabel', 'imageRef',
            'createdAt', 'updatedAt', 'source'
          ])
          // Narrowed from five types to two when the heart was consolidated
          // onto Where to Stay and Explore Nature. Existing car/tour/flight
          // rows stay deletable (delete checks ownership only, not shape),
          // so an old favourite can still be cleared — it just cannot be
          // recreated.
          && request.resource.data.itemType in ['nature_spot', 'hotel']
          && request.resource.data.itemId is string
          && request.resource.data.itemId.size() > 0
          && request.resource.data.itemId.size() <= 200
          // The denormalized snapshot the Favorites screen draws each row
          // from (DATA_MODEL.md -> favorites). The title is required —
          // a row with no name cannot be rendered and would look like data
          // loss. The place line is optional so a catalogue entry that has
          // not been given one yet can still be saved: the row then omits
          // that line instead of the save failing in the user's face.
          && validLocaleMap(request.resource.data.title)
          && (!('locationLabel' in request.resource.data.keys())
              || validLocaleMap(request.resource.data.locationLabel))
          // Optional: a Storage download URL or a bundled asset path.
          && (!('imageRef' in request.resource.data.keys())
              || (request.resource.data.imageRef is string
                  && request.resource.data.imageRef.size() <= 1000));
      }

      allow get, list: if ownsExisting();
      allow create: if ownsIncoming() && validShape();
      // A favourite is added or removed, never edited in place — allowing
      // update would only add a way to repoint a row at another user.
      allow update: if false;
      allow delete: if ownsExisting();
    }

    // -------------------------------------------------------------------
    // bookings — a user's own hotel/car/flight/tour reservations.
    //
    // READ-ONLY FROM THE CLIENT, and owner-only at that.
    //
    // Creation belongs to the checkout Cloud Function, which runs only after
    // the payment provider confirms the charge (SECURITY.md section 5). If a
    // client could create here, a modified app could mint itself a confirmed
    // booking it never paid for — the single most valuable thing to forge in
    // this app. Cancellation is likewise a Cloud Function: it has to call the
    // provider's cancel API and compute the refund, neither of which a client
    // can be trusted to do. The Admin SDK bypasses these rules, so denying
    // every client write costs the server nothing.
    //
    // `list` is allowed only because the rule pins resource.data.userId to
    // the caller: Firestore rejects any query not provably limited to the
    // caller's own documents, so `where('userId', == someoneElse)` fails
    // rather than returning another user's trips. Same mechanism as
    // favorites.
    //
    // There is no guest booking — request.auth must exist — so a signed-out
    // user is shown a sign-in prompt rather than an empty list.
    // -------------------------------------------------------------------
    match /bookings/{bookingId} {
      function ownsExisting() {
        return request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      allow get, list: if ownsExisting();
      // Every write path is server-side. See the note above.
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------
    // Catch-all deny. Every future collection must add an explicit rule
    // above this line; nothing is granted access by omission.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
